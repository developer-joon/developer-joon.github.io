{
  "name": "breadlab-community",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "build": "vite build",
    "check": "npm run test -- --run && npm run typecheck && npm run lint",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:test:storage-upgrade": "bash ../supabase/tests/storage_upgrade.sh",
    "db:lint": "supabase db lint --level error",
    "db:stop": "supabase stop"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "globals": "16.5.0",
    "jsdom": "30.1.1",
    "supabase": "2.118.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": "^24.15.0"
  }
}
