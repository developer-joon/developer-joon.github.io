    {"id": "statutory-social-insurance", "category_id": "health", "label_ko": "법정 사회보험", "baseline_kind": "statutory_or_mandatory"},
    {"id": "tuition-assistance", "category_id": "growth", "label_ko": "학비·등록금 지원"},
    {"id": "job-training", "category_id": "growth", "label_ko": "직무교육"},
    {"id": "certification-language", "category_id": "growth", "label_ko": "자격·어학 지원"},
