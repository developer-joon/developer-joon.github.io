    {"id": "transport-allowance", "category_id": "commute", "label_ko": "교통·차량 지원"},
    {"id": "retirement-defined-contribution", "category_id": "retirement", "label_ko": "확정기여형 퇴직저축"},
    {"id": "retirement-employer-match", "category_id": "retirement", "label_ko": "고용주 퇴직저축 매칭"},
    {"id": "retirement-employer-core", "category_id": "retirement", "label_ko": "고용주 기본 퇴직기여"},
