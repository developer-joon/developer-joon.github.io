    {"id": "paid-time-off", "category_id": "leave", "label_ko": "유급휴가 제도"},
    {"id": "family-event-leave", "category_id": "leave", "label_ko": "경조휴가"},
    {"id": "flexible-hours", "category_id": "remote", "label_ko": "유연·시차 근무"},
    {"id": "remote-work", "category_id": "remote", "label_ko": "원격근무"},
    {"id": "parental-leave", "category_id": "family", "label_ko": "출산·육아휴직"},
    {"id": "childcare", "category_id": "family", "label_ko": "보육 지원"},
    {"id": "child-education", "category_id": "family", "label_ko": "자녀 교육비"},
    {"id": "family-events", "category_id": "family", "label_ko": "경조·가족 행사 지원"},
    {"id": "medical", "category_id": "health", "label_ko": "의료·건강보험"},
    {"id": "dental", "category_id": "health", "label_ko": "치과 보장"},
    {"id": "vision", "category_id": "health", "label_ko": "시력 보장"},
    {"id": "health-screening", "category_id": "health", "label_ko": "건강검진"},
    {"id": "life-insurance", "category_id": "health", "label_ko": "생명·단체보험"},
    {"id": "accident-insurance", "category_id": "health", "label_ko": "상해·AD&D 보험"},
    {"id": "short-term-disability", "category_id": "health", "label_ko": "단기 장애 보장"},
