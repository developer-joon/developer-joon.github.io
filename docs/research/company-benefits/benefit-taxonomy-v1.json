    {"id": "caregiver-family-assistance", "category_id": "inclusion", "label_ko": "가족·돌봄 지원"}
  ],
  "dol_form_5500_mappings": [
    {"field": "TYPE_PENSION_BNFT_CODE", "code": "2J", "benefit_type_id": "retirement-defined-contribution", "label_en": "Code section 401(k) feature", "forced_status": "bounded", "evidence_semantics": "historical_named_plan_feature_only"},
    {"field": "TYPE_WELFARE_BNFT_CODE", "code": "4A", "benefit_type_id": "medical", "label_en": "Health (other than vision or dental)", "forced_status": "bounded", "evidence_semantics": "historical_named_plan_feature_only"},
    {"field": "TYPE_WELFARE_BNFT_CODE", "code": "4B", "benefit_type_id": "life-insurance", "label_en": "Life insurance", "forced_status": "bounded", "evidence_semantics": "historical_named_plan_feature_only"},
    {"field": "TYPE_WELFARE_BNFT_CODE", "code": "4D", "benefit_type_id": "dental", "label_en": "Dental", "forced_status": "bounded", "evidence_semantics": "historical_named_plan_feature_only"},
    {"field": "TYPE_WELFARE_BNFT_CODE", "code": "4E", "benefit_type_id": "vision", "label_en": "Vision", "forced_status": "bounded", "evidence_semantics": "historical_named_plan_feature_only"},
    {"field": "TYPE_WELFARE_BNFT_CODE", "code": "4F", "benefit_type_id": "short-term-disability", "label_en": "Temporary disability (accident and sickness)", "forced_status": "bounded", "evidence_semantics": "historical_named_plan_feature_only"},
    {"field": "TYPE_WELFARE_BNFT_CODE", "code": "4G", "benefit_type_id": "prepaid-legal", "label_en": "Prepaid legal", "forced_status": "bounded", "evidence_semantics": "historical_named_plan_feature_only"},
    {"field": "TYPE_WELFARE_BNFT_CODE", "code": "4H", "benefit_type_id": "long-term-disability", "label_en": "Long-term disability", "forced_status": "bounded", "evidence_semantics": "historical_named_plan_feature_only"},
    {"field": "TYPE_WELFARE_BNFT_CODE", "code": "4I", "benefit_type_id": "severance", "label_en": "Severance pay", "forced_status": "bounded", "evidence_semantics": "historical_named_plan_feature_only"}
  ],
  "dol_guards": [
    "require_exact_plan_row_source_and_official_code_definition_source",
    "require_plan_name_sponsor_ein_plan_year_and_ack_id",
    "never_infer_current_availability",
    "never_infer_individual_eligibility",
    "never_infer_affiliate_or_group_coverage",
    "never_upgrade_historical_to_confirmed"
  ],
  "mapping_precedence": [
    "reviewed_exact_claim_assignment",
    "exact_dol_field_and_code_mapping",
    "otherwise_fail_closed"
  ],
  "production_name_heuristics": "prohibited",
  "bundled_claim_policy": {
    "automatic_text_splitting": "prohibited",
    "required_input": "reviewed_exact_claim_assignment_with_one_or_more_benefit_type_ids",
    "category_count_rule": "count_source_claim_once_per_category_even_when_multiple_types_map_to_that_category",
    "detail_rule": "preserve_original_claim_text_and_show_all_reviewed_type_labels"
  },
  "domestic_claim_semantics": [
    "bind_to_exact_korean_legal_entity_not_brand_or_group",
    "do_not_transfer_group_recruiting_page_benefits_without_entity_binding",
    "map_4대보험_to_statutory_social_insurance_and_label_as_baseline_not_differentiator",
    "unspecified_role_employment_or_tenure_scope_forces_bounded",
    "worksite_or_nonlocal_resident_conditions_remain_visible_scope_limits",
    "unknown_exact_entity_result_is_insufficient_evidence_not_absence"
  ]
}
