{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "artifact_kind": "benefit_taxonomy",
  "taxonomy_version": "benefit-taxonomy-v1",
  "language": "ko-KR",
  "principles": {
    "overall_ranking": "prohibited",
    "category_ranking": "prohibited",
    "numeric_scores": "prohibited",
    "absence_inference": "prohibited",
    "unmapped_evidenced_claim": "fail_closed",
    "insufficient_evidence": "separate_outcome",
    "personal_conditions_storage": [
      "url_query",
      "browser_memory"
    ],
    "server_or_account_storage": "prohibited"
  },
  "category_outcome_contract": {
    "discriminator": "kind",
    "variants": [
      {
        "kind": "evidenced",
        "allowed_statuses": [
          "confirmed",
          "bounded"
        ],
        "required_fields": [
          "category_id",
          "status",
          "claim_count",
          "benefit_type_count",
          "scope",
          "limitations",
          "last_checked_at"
        ],
        "forbidden_fields": [
          "score",
          "rank",
          "percentile",
          "coverage_percent"
        ]
      },
      {
        "kind": "insufficient_evidence",
        "allowed_statuses": [],
        "required_fields": [
          "category_id",
          "reason_code",
          "nonabsence_notice",
          "searched_source_ids",
          "searched_at"
        ],
        "forbidden_fields": [
          "status",
          "score",
          "rank",
          "zero"
        ]
      }
    ]
  },
  "status_derivation": {
    "confirmed": {
      "all": [
        "at_least_one_mapped_claim",
        "claim.status_is_confirmed",
        "claim.current_validity_is_current_or_undated_current",
        "claim.has_grade_a_or_b_evidence",
        "country_scope_is_explicit",
        "legal_entity_scope_is_explicit",
        "role_scope_is_explicit_or_explicitly_all_employees",
        "employment_type_scope_is_explicit_or_explicitly_all_employees",
        "tenure_condition_is_explicit_including_explicit_none",
        "no_unresolved_conflict_for_category"
      ]
    },
    "bounded": {
      "any": [
        "claim.status_is_limited",
        "claim.status_is_past",
        "claim.status_is_name_only",
        "claim.status_is_conflict",
        "claim.current_validity_is_historical",
        "role_scope_is_not_publicly_specified",
        "employment_type_scope_is_not_publicly_specified",
        "tenure_condition_is_not_stated",
        "source_only_proves_named_plan_and_plan_year",
        "category_contains_unresolved_conflict"
      ]
    },
    "aggregation": "confirmed_only_if_at_least_one_fully_confirmed_projection_and_no_bounded_projection_or_conflict;otherwise_bounded",
    "unknown_claims": "never_enter_evidenced_outcome"
  },
  "scope_contract": {
    "required_dimensions": [
      "countries",
      "legal_entities",
      "roles",
      "employment_types",
      "tenure_condition"
    ],
    "display": "always_visible_on_category_and_claim_detail",
    "unknown_markers": [
      "not stated by source",
      "not publicly specified by the source",
      "not established by searched public source",
      "unspecified employees",
      "출처에 명시되지 않음",
      "확인 불가"
    ],
    "unknown_marker_effect": "bounded",
    "population_entity_inheritance": "prohibited",
    "group_or_affiliate_transfer": "prohibited"
  },
  "categories": [
    {
      "id": "leave",
      "label_ko": "휴가·근무시간",
      "order": 1
    },
    {
      "id": "family",
      "label_ko": "육아·가족",
      "order": 2
    },
    {
      "id": "health",
      "label_ko": "건강·보험",
      "order": 3
    },
    {
      "id": "growth",
      "label_ko": "교육·성장",
      "order": 4
    },
    {
      "id": "housing",
      "label_ko": "주거·금융",
      "order": 5
    },
    {
      "id": "commute",
      "label_ko": "이동·통근",
      "order": 6
    },
    {
      "id": "remote",
      "label_ko": "유연근무·원격근무",
      "order": 7
    },
    {
      "id": "retirement",
      "label_ko": "퇴직·장기근속",
      "order": 8
    },
    {
      "id": "meals",
      "label_ko": "식사·생활편의",
      "order": 9
    },
    {
      "id": "inclusion",
      "label_ko": "포용·접근성",
      "order": 10
    }
  ],
  "benefit_types": [
    {"id": "paid-leave", "category_id": "leave", "label_ko": "유급휴가"},
