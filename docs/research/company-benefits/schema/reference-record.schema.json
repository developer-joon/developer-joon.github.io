{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reference-record.schema.json",
  "title": "Non-official company benefit reference record v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reference_id", "cell_id", "company_id", "category_id", "source_id",
    "source_tier", "statement", "supporting_quote", "source_locator",
    "reliability", "currentness", "scope", "conflict_status",
    "publication_eligibility", "checked_at"
  ],
  "properties": {
    "reference_id": {"type": "string", "pattern": "^reference::[A-Za-z0-9][A-Za-z0-9._:-]{2,220}$"},
    "cell_id": {"type": "string", "pattern": "^cell::[A-Za-z0-9][A-Za-z0-9._:-]{2,127}::[a-z][a-z0-9-]{1,63}$"},
    "company_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "category_id": {"enum": ["leave", "family", "health", "growth", "housing", "commute", "remote", "retirement", "meals", "inclusion"]},
    "source_id": {"type": "string", "pattern": "^source::[A-Za-z0-9][A-Za-z0-9._:-]{2,220}$"},
    "source_tier": {"enum": ["company_recruiting_major_media", "other_public_web"]},
    "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
    "supporting_quote": {"type": "string", "minLength": 1, "maxLength": 2000},
    "source_locator": {"type": "string", "format": "uri", "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?(?:[/?#][^\\s]*)?$"},
    "reliability": {"enum": ["medium", "low"]},
    "currentness": {"enum": ["current", "historical", "unknown"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "countries", "legal_entities", "roles", "employment_types"],
      "properties": {
        "status": {"enum": ["exact_entity", "group_only", "unresolved"]},
        "countries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]{2}$"}},
        "legal_entities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "employment_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "conflict_status": {"enum": ["none", "disclosed", "unresolved"]},
    "publication_eligibility": {"enum": ["eligible", "ineligible"]},
    "checked_at": {"type": "string", "format": "date-time", "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"}
  },
  "allOf": [
    {
      "if": {"properties": {"publication_eligibility": {"const": "eligible"}}},
      "then": {
        "properties": {
          "scope": {"properties": {"status": {"enum": ["exact_entity", "group_only"]}}},
          "conflict_status": {"enum": ["none", "disclosed"]}
        }
      }
    }
  ]
}
