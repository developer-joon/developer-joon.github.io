{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External company-benefits freeze anchor receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "freeze_manifest_sha256",
    "review_status",
    "issued_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "freeze_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review_status": {
      "enum": [
        "review_pending",
        "approved"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
