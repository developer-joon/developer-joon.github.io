{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benefit-taxonomy-assignment.schema.json",
  "title": "Independently reviewed outcome bound to an exact taxonomy assignment request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "request_sha256",
    "claim_id",
    "assignment",
    "taxonomy_version",
    "taxonomy_sha256",
    "bindings",
    "researcher_id",
    "reviewer_id",
    "reviewed_at",
    "decision"
  ],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "claim_id": {"type": "string", "minLength": 1},
    "assignment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "category_ids", "benefit_type_ids"],
          "properties": {
            "state": {"const": "assigned"},
            "category_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "benefit_type_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reason"],
          "properties": {
            "state": {"const": "unclassified"},
            "reason": {
              "enum": [
                "no_unambiguous_taxonomy_match",
                "insufficient_claim_specific_evidence"
              ]
            }
          }
        }
      ]
    },
    "taxonomy_version": {"type": "string", "minLength": 1},
    "taxonomy_sha256": {"$ref": "#/$defs/sha256"},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_byte_contract",
        "claim_record_sha256",
        "source_records",
        "factual_review_record",
        "prepublication_check_records"
      ],
      "properties": {
        "record_byte_contract": {"const": "exact_utf8_jsonl_record_excluding_lf_terminator"},
        "claim_record_sha256": {"$ref": "#/$defs/sha256"},
        "source_records": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceBinding"}
        },
        "factual_review_record": {
          "type": "object",
          "additionalProperties": false,
          "required": ["review_id", "record_sha256"],
          "properties": {
            "review_id": {"type": "string", "minLength": 1},
            "record_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "prepublication_check_records": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceBinding"}
        }
      }
    },
    "researcher_id": {
      "description": "Must equal the bound request's requested_by producer identity.",
      "type": "string",
      "minLength": 1
    },
    "reviewer_id": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "decision": {"const": "approved"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "record_sha256"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "record_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
