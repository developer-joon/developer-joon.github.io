{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "community-benefit-report.schema.json",
  "title": "Moderated community benefit report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "community_report_id", "cell_id", "company_id", "category_id", "source_id",
    "source_tier", "statement", "reliability", "currentness", "scope_status", "scope",
    "conflict_status", "moderation", "publication_eligibility"
  ],
  "properties": {
    "community_report_id": {"type": "string", "pattern": "^community::[A-Za-z0-9][A-Za-z0-9._:-]{2,220}$"},
    "cell_id": {"type": "string", "pattern": "^cell::[A-Za-z0-9][A-Za-z0-9._:-]{2,127}::[a-z][a-z0-9-]{1,63}$"},
    "company_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "category_id": {"enum": ["leave", "family", "health", "growth", "housing", "commute", "remote", "retirement", "meals", "inclusion"]},
    "source_id": {"type": "string", "pattern": "^source::[A-Za-z0-9][A-Za-z0-9._:-]{2,220}$"},
    "source_tier": {"enum": ["community_employee_review", "user_submission"]},
    "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
    "reliability": {"const": "low"},
    "currentness": {"enum": ["current", "historical", "unknown"]},
    "scope_status": {"enum": ["exact_entity", "group_only", "unresolved"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["countries", "legal_entities", "roles", "employment_types"],
      "properties": {
        "countries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]{2}$"}},
        "legal_entities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "employment_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "conflict_status": {"enum": ["none", "disclosed", "unresolved"]},
    "moderation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {"status": {"const": "pending"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reviewer_id", "reviewed_at", "decision_sha256"],
          "properties": {
            "status": {"enum": ["approved", "rejected"]},
            "reviewer_id": {"type": "string", "pattern": "^moderator::[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
            "reviewed_at": {"type": "string", "format": "date-time", "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"},
            "decision_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "frozen_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "content_sha256", "frozen_at"],
      "properties": {
        "locator": {"type": "string", "format": "uri", "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?(?:[/?#][^\\s]*)?$"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "frozen_at": {"type": "string", "format": "date-time", "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"}
      }
    },
    "publication_eligibility": {"enum": ["eligible", "ineligible"]}
  },
  "allOf": [
    {
      "if": {"properties": {"publication_eligibility": {"const": "eligible"}}},
      "then": {
        "required": ["frozen_snapshot"],
        "properties": {
          "moderation": {"properties": {"status": {"const": "approved"}}},
          "conflict_status": {"enum": ["none", "disclosed"]}
        }
      }
    }
  ]
}
