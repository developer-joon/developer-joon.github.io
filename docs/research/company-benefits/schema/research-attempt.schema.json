{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-attempt.schema.json",
  "title": "Category-specific company benefit research attempt receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attempt_id", "cell_id", "company_id", "category_id", "jurisdiction",
    "coverage_policy_id", "route_id", "route_kind", "query_or_locator",
    "started_at", "completed_at", "result", "source_ids",
    "raw_response_sha256", "capture_locator", "collector_version", "receipt_content_sha256"
  ],
  "properties": {
    "attempt_id": {"type": "string", "pattern": "^attempt::[A-Za-z0-9][A-Za-z0-9._:-]{2,220}$"},
    "cell_id": {"type": "string", "pattern": "^cell::[A-Za-z0-9][A-Za-z0-9._:-]{2,127}::[a-z][a-z0-9-]{1,63}$"},
    "company_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "category_id": {"enum": ["leave", "family", "health", "growth", "housing", "commute", "remote", "retirement", "meals", "inclusion"]},
    "jurisdiction": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "coverage_policy_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "route_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "route_kind": {"enum": ["official_government", "company_recruiting_major_media", "other_public_web", "community_employee_review", "user_submission"]},
    "query_or_locator": {"type": "string", "minLength": 3, "maxLength": 2000},
    "started_at": {"type": "string", "format": "date-time", "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"},
    "completed_at": {"type": "string", "format": "date-time", "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"},
    "result": {"enum": ["source_found", "no_result", "access_failed", "ineligible_source"]},
    "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^source::[A-Za-z0-9][A-Za-z0-9._:-]{2,220}$"}},
    "raw_response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capture_locator": {"type": "string", "format": "uri", "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?(?:[/?#][^\\s]*)?$"},
    "collector_version": {"type": "string", "pattern": "^[a-z][a-z0-9-]*/[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "receipt_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "shared_bulk_result_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "company_id", "category_id", "result_locator", "result_sha256"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^source::[A-Za-z0-9][A-Za-z0-9._:-]{2,220}$"},
        "company_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
        "category_id": {"enum": ["leave", "family", "health", "growth", "housing", "commute", "remote", "retirement", "meals", "inclusion"]},
        "result_locator": {"type": "string", "minLength": 3, "maxLength": 2000},
        "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "source_found"}}},
      "then": {"properties": {"source_ids": {"minItems": 1}}},
      "else": {"properties": {"source_ids": {"maxItems": 0}}}
    }
  ]
}
