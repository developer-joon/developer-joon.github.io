{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "population-protocol.schema.json",
  "title": "Company benefits population protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_id",
    "version",
    "status",
    "approval",
    "cutoff_at",
    "purpose",
    "non_ranking_statement",
    "scopes",
    "classification",
    "thresholds",
    "currency_conversion",
    "source_precedence",
    "canonical_selection",
    "immutable_model",
    "coverage_gap",
    "blockers",
    "forbidden_while_blocked"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "protocol_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "blocked",
        "approved",
        "superseded"
      ]
    },
    "approval": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "approved_by",
            "approved_at"
          ],
          "properties": {
            "approved_by": {
              "type": "string",
              "minLength": 1
            },
            "approved_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    },
    "cutoff_at": {
      "type": "string",
      "format": "date-time"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "non_ranking_statement": {
      "type": "string",
      "minLength": 1
    },
    "scopes": {
      "type": "object",
      "required": [
        "domestic",
        "international"
      ]
    },
    "classification": {
      "type": "object",
      "required": [
        "selection_unit",
        "domestic_rule",
        "international_rule",
        "separate_roles",
        "related_entity_rule"
      ]
    },
    "thresholds": {
      "type": "object",
      "required": [
        "domestic_non_financial",
        "international_non_financial",
        "domestic_financial",
        "international_financial",
        "public_sector_rule",
        "maximum_fiscal_age_months"
      ]
    },
    "currency_conversion": {
      "type": "object",
      "required": [
        "source_owner",
        "indicator",
        "url",
        "rule"
      ]
    },
    "source_precedence": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "canonical_selection": {
      "type": "object",
      "required": [
        "seed",
        "required_fields",
        "jurisdiction_format",
        "normalization",
        "serialization",
        "hash",
        "missing_value_rule",
        "order",
        "exclusion_rule",
        "replacement_rule",
        "next_hash_rule"
      ]
    },
    "immutable_model": {
      "type": "object",
      "required": [
        "eligible_ledgers",
        "selected_ledgers",
        "effective_ledgers",
        "event_ledger",
        "freeze_manifest",
        "effective_manifest",
        "state_rule"
      ]
    },
    "coverage_gap": {
      "type": "object",
      "minProperties": 19,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "gate",
          "requirement",
          "jurisdictions"
        ],
        "properties": {
          "gate": {
            "type": "string"
          },
          "requirement": {
            "type": "string"
          },
          "jurisdictions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          }
        }
      }
    },
    "forbidden_while_blocked": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        }
      },
      "then": {
        "properties": {
          "approval": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "draft",
              "blocked"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "approval": {
            "type": "null"
          }
        }
      }
    }
  ]
}
