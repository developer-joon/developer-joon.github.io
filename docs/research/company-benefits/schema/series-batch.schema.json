{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "company-benefits-series-batch.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "batch_id", "scope", "batch_number", "company_list_sha256", "effective_sequence_sha256", "replacement_events_sha256", "company_ids"],
  "properties": {
    "manifest_version": {"const": "1"},
    "batch_id": {"type": "string", "pattern": "^(domestic|international)-(0[1-9]|[1-3][0-9]|40)$"},
    "scope": {"enum": ["domestic", "international"]},
    "batch_number": {"type": "integer", "minimum": 1, "maximum": 40},
    "company_list_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "effective_sequence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "replacement_events_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "company_ids": {"type": "array", "minItems": 25, "maxItems": 25, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
