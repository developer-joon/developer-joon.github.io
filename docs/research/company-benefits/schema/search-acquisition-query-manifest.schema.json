{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "search-acquisition-query-manifest.schema.json",
  "title": "Company benefits search acquisition query manifest",
  "description": "Locale-aware review-only queries for an external search tool. This manifest cannot serve as an attempt receipt or source decision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "format_version", "created_at", "source_requests_sha256", "entry_count", "entries", "artifact_content_sha256"],
  "properties": {
    "artifact_type": {"const": "company-benefits-search-query-manifest"},
    "format_version": {"enum": [1, 2]},
    "batch_id": {"type": "string", "pattern": "^[a-z0-9-]{3,80}$"},
    "unit_id": {"type": "string", "pattern": "^[a-z0-9-]{3,100}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "source_requests_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "company_count": {"type": "integer", "minimum": 1, "maximum": 25},
    "cell_count": {"type": "integer", "minimum": 1, "maximum": 250},
    "company_ids": {"type": "array", "minItems": 1, "maxItems": 25, "uniqueItems": true, "items": {"type": "string", "minLength": 3, "maxLength": 220}},
    "broad_query_count": {"type": "integer", "minimum": 0, "maximum": 75},
    "deferred_query_count": {"type": "integer", "minimum": 0, "maximum": 750},
    "entry_count": {"type": "integer", "minimum": 1, "maximum": 1000},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query_id", "company_id", "category_id", "jurisdiction", "route_id", "route_kind", "query_or_locator", "tool_name", "max_results", "authoritative_use_prohibited"],
        "properties": {
          "query_id": {"type": "string", "pattern": "^search-query::[^:]+::(?:broad|[a-z][a-z0-9-]{2,63})::(official-government|company-recruiting-media|other-public-web)$"},
          "company_id": {"type": "string", "minLength": 3, "maxLength": 220},
          "legal_name": {"type": "string", "minLength": 1, "maxLength": 500},
          "search_aliases": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
          "category_id": {"type": "string", "pattern": "^(?:broad|[a-z][a-z0-9-]{2,63})$"},
          "category_terms": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
          "jurisdiction": {"type": "string", "pattern": "^[A-Z]{2}$"},
          "route_id": {"enum": ["official-government", "company-recruiting-media", "other-public-web"]},
          "route_kind": {"enum": ["official_government", "company_recruiting_major_media", "other_public_web"]},
          "query_stage": {"enum": ["broad-discovery", "category-gap"]},
          "execution_status": {"enum": ["ready", "deferred"]},
          "query_or_locator": {"type": "string", "minLength": 1, "maxLength": 2000},
          "tool_name": {"const": "web_search"},
          "max_results": {"type": "integer", "minimum": 1, "maximum": 20},
          "candidate_policy": {"enum": ["explicit-category-support-review-only", "required-route-receipt-for-unresolved-cell"]},
          "entity_acceptance": {"const": "exact-alias-review-required"},
          "authoritative_use_prohibited": {"const": true}
        }
      }
    },
    "artifact_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
