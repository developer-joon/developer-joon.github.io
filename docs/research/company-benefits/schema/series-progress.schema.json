{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "company-benefits-series-progress.schema.json",
  "oneOf": [
    {"$ref": "#/$defs/legacyProgress"},
    {"$ref": "#/$defs/v2Progress"}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ledgerHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company-category-cells.jsonl", "research-attempts.jsonl", "official-claims-v2.jsonl", "reference-records.jsonl", "community-benefit-reports.jsonl", "sources-v2.jsonl"],
      "properties": {
        "company-category-cells.jsonl": {"$ref": "#/$defs/hash"},
        "research-attempts.jsonl": {"$ref": "#/$defs/hash"},
        "official-claims-v2.jsonl": {"$ref": "#/$defs/hash"},
        "reference-records.jsonl": {"$ref": "#/$defs/hash"},
        "community-benefit-reports.jsonl": {"$ref": "#/$defs/hash"},
        "sources-v2.jsonl": {"$ref": "#/$defs/hash"}
      }
    },
    "legacyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "scope", "batch_number", "status", "company_list_sha256", "claim_count", "no_claim_count"],
      "properties": {
        "batch_id": {"type": "string"},
        "scope": {"enum": ["domestic", "international"]},
        "batch_number": {"type": "integer", "minimum": 1, "maximum": 40},
        "status": {"enum": ["pending", "approved"]},
        "company_list_sha256": {"$ref": "#/$defs/hash"},
        "claim_count": {"type": "integer", "minimum": 0},
        "no_claim_count": {"type": "integer", "minimum": 0},
        "approved_at": {"type": "string", "format": "date-time"},
        "reviewer_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]},
          "then": {"required": ["approved_at", "reviewer_ids"]},
          "else": {"not": {"anyOf": [{"required": ["approved_at"]}, {"required": ["reviewer_ids"]}]}}
        }
      ]
    },
    "v2Entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "scope", "batch_number", "status", "company_list_sha256", "claim_count", "no_claim_count", "cell_count"],
      "properties": {
        "batch_id": {"type": "string"},
        "scope": {"enum": ["domestic", "international"]},
        "batch_number": {"type": "integer", "minimum": 1, "maximum": 40},
        "status": {"enum": ["pending", "approved"]},
        "company_list_sha256": {"$ref": "#/$defs/hash"},
        "claim_count": {"type": "integer", "minimum": 0},
        "no_claim_count": {"type": "integer", "minimum": 0},
        "cell_count": {"type": "integer"},
        "cell_set_sha256": {"$ref": "#/$defs/hash"},
        "v2_ledger_sha256": {"$ref": "#/$defs/ledgerHashes"},
        "approved_at": {"type": "string", "format": "date-time"},
        "reviewer_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]},
          "then": {
            "required": ["approved_at", "reviewer_ids", "cell_set_sha256", "v2_ledger_sha256"],
            "properties": {"cell_count": {"const": 250}}
          },
          "else": {
            "properties": {"cell_count": {"const": 0}},
            "not": {"anyOf": [
              {"required": ["approved_at"]}, {"required": ["reviewer_ids"]},
              {"required": ["cell_set_sha256"]}, {"required": ["v2_ledger_sha256"]}
            ]}
          }
        }
      ]
    },
    "legacyProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_version", "status", "company_list_sha256", "total_companies", "total_batches", "batches"],
      "properties": {
        "manifest_version": {"const": "1"},
        "progress_version": {"const": "1"},
        "status": {"enum": ["in_progress", "complete"]},
        "company_list_sha256": {"$ref": "#/$defs/hash"},
        "total_companies": {"const": 2000},
        "total_batches": {"const": 80},
        "batches": {"type": "array", "minItems": 80, "maxItems": 80, "items": {"$ref": "#/$defs/legacyEntry"}}
      }
    },
    "v2Progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_version", "progress_version", "status", "company_list_sha256", "total_companies", "total_batches", "total_cells", "batches"],
      "properties": {
        "manifest_version": {"const": "1"},
        "progress_version": {"const": "2"},
        "status": {"enum": ["in_progress", "complete"]},
        "company_list_sha256": {"$ref": "#/$defs/hash"},
        "total_companies": {"const": 2000},
        "total_batches": {"const": 80},
        "total_cells": {"const": 20000},
        "batches": {"type": "array", "minItems": 80, "maxItems": 80, "items": {"$ref": "#/$defs/v2Entry"}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "complete"}}, "required": ["status"]},
          "then": {
            "properties": {
              "batches": {
                "items": {
                  "properties": {"status": {"const": "approved"}},
                  "required": ["status"]
                }
              }
            }
          }
        }
      ]
    }
  }
}
