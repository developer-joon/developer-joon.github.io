{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-v2.schema.json",
  "title": "Company benefit public evidence source v2",
  "description": "A separate v2 contract; source.schema.json remains unchanged for v1 compatibility.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id", "source_tier", "title", "url", "retrieved_at", "content_sha256",
    "reliability", "currentness", "scope_status", "scope", "conflict_status",
    "publication_eligibility"
  ],
  "properties": {
    "source_id": {"type": "string", "pattern": "^source::[A-Za-z0-9][A-Za-z0-9._:-]{2,220}$"},
    "source_tier": {"enum": ["official_government", "company_recruiting_major_media", "other_public_web", "community_employee_review", "user_submission"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 500},
    "url": {"type": "string", "format": "uri", "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?(?:[/?#][^\\s]*)?$"},
    "retrieved_at": {"type": "string", "format": "date-time", "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reliability": {"enum": ["high", "medium", "low", "unrated"]},
    "currentness": {"enum": ["current", "historical", "unknown"]},
    "scope_status": {"enum": ["exact_entity", "group_only", "unresolved"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["countries", "legal_entities", "roles", "employment_types"],
      "properties": {
        "countries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]{2}$"}},
        "legal_entities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "employment_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "conflict_status": {"enum": ["none", "disclosed", "unresolved"]},
    "publication_eligibility": {"enum": ["eligible", "ineligible"]}
  },
  "allOf": [
    {
      "if": {"properties": {"publication_eligibility": {"const": "eligible"}}},
      "then": {"properties": {"conflict_status": {"enum": ["none", "disclosed"]}}}
    }
  ]
}
