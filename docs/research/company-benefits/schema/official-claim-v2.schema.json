{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "official-claim-v2.schema.json",
  "title": "Official company benefit claim v2",
  "description": "A separate v2 contract; benefit-claim.schema.json remains unchanged for v1 compatibility.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id", "cell_id", "company_id", "category_id", "jurisdiction",
    "source_ids", "source_tier", "scope_status", "scope", "publication_eligibility"
  ],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,255}$"},
    "cell_id": {"type": "string", "pattern": "^cell::[A-Za-z0-9][A-Za-z0-9._:-]{2,127}::[a-z][a-z0-9-]{1,63}$"},
    "company_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "category_id": {"enum": ["leave", "family", "health", "growth", "housing", "commute", "remote", "retirement", "meals", "inclusion"]},
    "jurisdiction": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^source::[A-Za-z0-9][A-Za-z0-9._:-]{2,220}$"}
    },
    "source_tier": {"const": "official_government"},
    "scope_status": {"const": "exact_entity"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["countries", "legal_entities", "roles", "employment_types"],
      "properties": {
        "countries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]{2}$"}},
        "legal_entities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "employment_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "publication_eligibility": {"const": "eligible"}
  }
}
