{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benefit-taxonomy-assignment-request.schema.json",
  "title": "Hash-bound pending benefit taxonomy assignment request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "request_sha256",
    "claim_id",
    "taxonomy_version",
    "taxonomy_sha256",
    "assignment",
    "bindings",
    "requested_by",
    "requested_at",
    "review_status"
  ],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "request_sha256": {
      "description": "SHA-256 of the RFC 8259 compact UTF-8 request object with insertion order preserved and this request_sha256 member omitted.",
      "$ref": "#/$defs/sha256"
    },
    "claim_id": {"type": "string", "minLength": 1},
    "taxonomy_version": {"type": "string", "minLength": 1},
    "taxonomy_sha256": {"$ref": "#/$defs/sha256"},
    "assignment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "benefit_type_ids"],
          "properties": {
            "state": {"const": "classified"},
            "benefit_type_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "benefit_type_ids", "reason_code"],
          "properties": {
            "state": {"const": "unclassified"},
            "benefit_type_ids": {"type": "array", "maxItems": 0},
            "reason_code": {
              "enum": [
                "no_unambiguous_taxonomy_match",
                "insufficient_claim_specific_evidence"
              ]
            }
          }
        }
      ]
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_byte_contract",
        "claim_record_sha256",
        "source_records",
        "factual_review_record",
        "prepublication_check_records"
      ],
      "properties": {
        "record_byte_contract": {"const": "exact_utf8_jsonl_record_excluding_lf_terminator"},
        "claim_record_sha256": {"$ref": "#/$defs/sha256"},
        "source_records": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceBinding"}
        },
        "factual_review_record": {
          "type": "object",
          "additionalProperties": false,
          "required": ["review_id", "record_sha256"],
          "properties": {
            "review_id": {"type": "string", "minLength": 1},
            "record_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "prepublication_check_records": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceBinding"}
        }
      }
    },
    "requested_by": {"const": "deterministic-benefit-taxonomy-generator-v1"},
    "requested_at": {"type": "string", "format": "date-time"},
    "review_status": {"const": "review_pending"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "record_sha256"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "record_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
