{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "company-category-cell.schema.json",
  "title": "Company benefit category research cell v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cell_id", "company_id", "category_id", "jurisdiction", "state",
    "coverage_policy_id", "attempt_ids", "official_claim_ids", "reference_ids",
    "community_report_ids", "reliability", "currentness", "scope_status",
    "conflict_status", "publication_eligibility", "assessed_at"
  ],
  "properties": {
    "cell_id": {"type": "string", "pattern": "^cell::[A-Za-z0-9][A-Za-z0-9._:-]{2,127}::[a-z][a-z0-9-]{1,63}$"},
    "company_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "category_id": {"enum": ["leave", "family", "health", "growth", "housing", "commute", "remote", "retirement", "meals", "inclusion"]},
    "jurisdiction": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "state": {"enum": ["official_verified", "reference", "community_report", "no_public_info"]},
    "coverage_policy_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "attempt_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^attempt::[A-Za-z0-9][A-Za-z0-9._:-]{2,220}$"}},
    "official_claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^official::[A-Za-z0-9][A-Za-z0-9._:-]{2,220}$"}},
    "reference_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^reference::[A-Za-z0-9][A-Za-z0-9._:-]{2,220}$"}},
    "community_report_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^community::[A-Za-z0-9][A-Za-z0-9._:-]{2,220}$"}},
    "reliability": {"enum": ["high", "medium", "low", "none"]},
    "currentness": {"enum": ["current", "historical", "unknown"]},
    "scope_status": {"enum": ["exact_entity", "bounded_entity", "group_only", "unresolved"]},
    "conflict_status": {"enum": ["none", "disclosed", "contradictory"]},
    "publication_eligibility": {"enum": ["official_claim", "reference_only", "community_only", "discovery_only"]},
    "coverage_complete": {"type": "boolean"},
    "assessed_at": {"type": "string", "format": "date-time", "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "official_verified"}}},
      "then": {"properties": {"official_claim_ids": {"minItems": 1}, "reliability": {"enum": ["high", "medium"]}, "scope_status": {"const": "exact_entity"}, "publication_eligibility": {"const": "official_claim"}}}
    },
    {
      "if": {"properties": {"state": {"const": "reference"}}},
      "then": {"properties": {"official_claim_ids": {"maxItems": 0}, "reference_ids": {"minItems": 1}, "reliability": {"enum": ["medium", "low"]}, "publication_eligibility": {"const": "reference_only"}}}
    },
    {
      "if": {"properties": {"state": {"const": "community_report"}}},
      "then": {"properties": {"official_claim_ids": {"maxItems": 0}, "reference_ids": {"maxItems": 0}, "community_report_ids": {"minItems": 1}, "reliability": {"const": "low"}, "publication_eligibility": {"const": "community_only"}}}
    },
    {
      "if": {"properties": {"state": {"const": "no_public_info"}}},
      "then": {
        "required": ["coverage_complete"],
        "properties": {
          "attempt_ids": {"minItems": 1},
          "official_claim_ids": {"maxItems": 0},
          "reference_ids": {"maxItems": 0},
          "community_report_ids": {"maxItems": 0},
          "reliability": {"const": "none"},
          "currentness": {"const": "unknown"},
          "coverage_complete": {"const": true},
          "publication_eligibility": {"const": "discovery_only"}
        }
      },
      "else": {"not": {"required": ["coverage_complete"]}}
    }
  ]
}
