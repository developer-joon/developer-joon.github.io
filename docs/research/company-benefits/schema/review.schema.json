{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review.schema.json",
  "title": "Independent claim review",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_id", "claim_id", "researcher_id", "reviewer_id", "decision", "reviewed_at", "issues", "resolution", "quote_entailment_confirmed"],
  "properties": {
    "review_id": {"type": "string", "minLength": 1}, "claim_id": {"type": "string", "minLength": 1},
    "researcher_id": {"type": "string", "minLength": 1}, "reviewer_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["approved", "changes_required", "rejected"]}, "reviewed_at": {"type": "string", "format": "date-time"},
    "issues": {"type": "array", "items": {"type": "string"}}, "resolution": {"type": "string", "minLength": 1},
    "quote_entailment_confirmed": {"type": "boolean"},
    "source_entailment_reviews": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "reviewed_role", "reviewed_proposition", "source_locator", "reviewed_quote", "content_sha256", "entailment_confirmed", "reviewer_id"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "reviewed_role": {"type": "string", "minLength": 1},
          "reviewed_proposition": {"type": "string", "minLength": 1},
          "source_locator": {"type": "string", "minLength": 1},
          "reviewed_quote": {"type": "string", "minLength": 1},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "entailment_confirmed": {"const": true},
          "reviewer_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "conflict_determination": {"enum": ["resolved_supports", "resolved_contradicts", "unresolved"]},
    "conflict_opposition_confirmed": {"type": "boolean"},
    "conflict_side_entailments": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "position", "reviewed_proposition", "source_locator", "reviewed_quote", "content_sha256", "entailment_confirmed", "reviewer_id"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "position": {"enum": ["supports", "contradicts"]},
          "reviewed_proposition": {"type": "string", "minLength": 1},
          "source_locator": {"type": "string", "minLength": 1},
          "reviewed_quote": {"type": "string", "minLength": 1},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "entailment_confirmed": {"const": true},
          "reviewer_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "unresolved_conflict_wording_approved": {"type": "boolean"}
  }
}
