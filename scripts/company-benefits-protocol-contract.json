  "canonical_selection": {
    "seed": "company-benefits-population-v1",
    "required_fields": [
      "jurisdiction",
      "registry_id",
      "legal_name"
    ],
    "jurisdiction_format": "ISO 3166-1 alpha-2 uppercase",
    "normalization": "Unicode NFC; trim every string; collapse internal legal_name whitespace to one ASCII space",
    "serialization": "Compact UTF-8 JSON array [protocol_seed,jurisdiction,registry_id,legal_name] with ensure_ascii=false, separators=(',', ':'), allow_nan=false",
    "hash": "SHA-256 lowercase hex",
    "missing_value_rule": "Reject; never substitute an empty string.",
    "order": "Ascending hash; on collision ascending canonical JSON bytes.",
    "exclusion_rule": "Append an exclusion/replacement event; do not mutate immutable selected records.",
    "replacement_rule": "Use the next unused eligible canonical-hash record in the same scope.",
    "next_hash_rule": "Each event records previous_effective_sha256 and next_effective_sha256; research cannot resume until the next hash is explicitly approved.",
    "replacement_event_required_fields": [
      "event_id",
      "protocol_version",
      "scope",
      "exclusion_reason",
      "exclusion_details",
      "excluded_company_id",
      "excluded_selection_hash",
      "excluded_hash_position",
      "replacement_company_id",
      "replacement_selection_hash",
      "previous_effective_sha256",
      "next_effective_sha256",
      "occurred_at",
      "approved_by"
    ],
    "exclusion_reason_enum": [
      "entity_ineligible",
      "duplicate_entity",
      "evidence_invalidated",
      "scope_correction"
    ]
  },
