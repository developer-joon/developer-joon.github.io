  "classification": {
    "selection_unit": "selected_employer_legal_entity",
    "domestic_rule": "The employing legal entity is incorporated in KR and has its registered head office in KR.",
    "international_rule": "The employing legal entity is incorporated outside KR and has its registered head office outside KR in a panel country.",
    "separate_roles": [
      "selected_employer_legal_entity",
      "financial_consolidation_parent",
      "ultimate_parent",
      "benefit_policy_owner"
    ],
    "related_entity_rule": "A parent and subsidiary may both qualify only with separate scale evidence and entity-specific benefit evidence; group policy is never inherited without applicability evidence."
  },
  "thresholds": {
    "domestic_non_financial": {
      "metric": "revenue",
      "minimum": 100000000000,
